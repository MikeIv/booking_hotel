# Публичный базовый URL API (см. nuxt.config.ts → runtimeConfig.public.apiBase)
NUXT_PUBLIC_API_BASE=

# ID счётчика Яндекс.Метрики (пусто — отключить). В yarn dev не загружается.
NUXT_PUBLIC_YANDEX_METRIKA_ID=80902204

# Хост dev-сервера (localhost обязателен для корректной работы CORS с бэкендом)
NUXT_HOST=localhost
# NUXT_PORT=3000
